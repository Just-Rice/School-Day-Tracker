# Firebase web app config (Firebase console → Project settings → Your apps → Web app).
# Copy to .env.local for local dev; in GitHub, add each as a repository *variable*
# (Settings → Secrets and variables → Actions → Variables) so the Pages build picks them up.
# Leave them empty and the app runs in local-only mode (data saved in the browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
